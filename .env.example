# Cloud service secrets. Set these in Railway variables, never in source control.
OPENROUTER_API_KEY=
MB_DASHBOARD_PASSWORD=
MB_SESSION_SECRET=
MB_EXPORT_TOKEN=
MB_MODE=cloud
MB_DATA_DIR=/data/monopolybench
RUNS_DIR=/data/monopolybench/runs
MB_MAX_ACTIVE_GAMES=5
MB_DISK_RESERVE_GB=5
MB_REQUEST_DEADLINE_S=1200
RAILWAY_DEPLOYMENT_DRAINING_SECONDS=180
# Local mock testing only: use a dummy API key and MB_DISK_RESERVE_GB=0.
# MB_OPENROUTER_BASE_URL=http://127.0.0.1:8765/api/v1
# Frontend development: VITE_MB_MODE=cloud; VITE_API_BASE=https://localhost:8000/api
