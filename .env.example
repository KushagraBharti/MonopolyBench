# Copy to .env for Docker Compose, or set variables in Railway.
# OPENROUTER_API_KEY is the only required external credential for real models.
OPENROUTER_API_KEY=
# Login uses this fixed default password; no username is needed.
MB_DASHBOARD_PASSWORD=monopoly
# Blank session/export secrets are generated and saved automatically.
MB_SESSION_SECRET=
MB_EXPORT_TOKEN=
# Set to 1 for the self-contained, zero-cost demo (separate Compose data volume).
MB_DEMO=0
MB_PORT=8000
# Optional custom persistent volume name; keep demo and research data separate.
# MB_DATA_VOLUME=monopolybench-data-0
MB_MODE=cloud
MB_DATA_DIR=/data/monopolybench
RUNS_DIR=/data/monopolybench/runs
MB_MAX_ACTIVE_GAMES=5
MB_DISK_RESERVE_GB=5
MB_REQUEST_DEADLINE_S=1200
RAILWAY_DEPLOYMENT_DRAINING_SECONDS=180
# Local mock testing only: use a dummy API key and MB_DISK_RESERVE_GB=0.
# MB_OPENROUTER_BASE_URL=http://127.0.0.1:8765/api/v1
# Compose enables HTTP cookies only for literal localhost/loopback hosts.
# Railway and remote HTTPS deployments retain Secure cookies by default.
# Frontend development: VITE_MB_MODE=cloud; VITE_API_BASE=https://localhost:8000/api
