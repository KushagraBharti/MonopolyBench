{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research_registry.schema.json",
  "title": "ResearchRegistryContracts",
  "type": "object",
  "additionalProperties": true,
  "$defs": {
    "promptPipelineMarker": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "const": "unchanged" },
        "note": { "type": "string" }
      }
    },
    "seedEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seed", "label", "rationale"],
      "properties": {
        "seed": { "type": "integer" },
        "label": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "seedCohort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cohort_id", "version", "description", "intended_use", "seeds"],
      "properties": {
        "cohort_id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "intended_use": { "type": "string", "minLength": 1 },
        "source_cohorts": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "seeds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/seedEntry" }
        }
      }
    },
    "seedRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "registry_version", "benchmark_id", "description", "cohorts", "prompt_pipeline"],
      "properties": {
        "schema_version": { "type": "string", "const": "v1" },
        "registry_version": { "type": "string", "const": "long_horizon_seed_registry_v1" },
        "benchmark_id": { "type": "string", "const": "monopoly-long-v1" },
        "description": { "type": "string" },
        "cohorts": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/seedCohort" }
        },
        "prompt_pipeline": { "$ref": "#/$defs/promptPipelineMarker" }
      }
    },
    "reasoning": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "properties": {
        "effort": { "type": "string", "enum": ["low", "medium", "high"] }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_id", "actor_type", "display_name", "enabled", "cost_budget_group", "notes"],
      "properties": {
        "actor_id": { "type": "string", "minLength": 1 },
        "actor_type": { "type": "string", "enum": ["llm", "baseline"] },
        "baseline_id": { "type": "string" },
        "display_name": { "type": "string", "minLength": 1 },
        "openrouter_model_id": { "type": "string" },
        "reasoning": { "$ref": "#/$defs/reasoning" },
        "temperature": { "type": ["number", "null"] },
        "top_p": { "type": ["number", "null"] },
        "enabled": { "type": "boolean" },
        "cost_budget_group": { "type": "string", "minLength": 1 },
        "notes": { "type": "string" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "actor_type": { "const": "llm" } },
            "required": ["actor_type"]
          },
          "then": { "required": ["openrouter_model_id"] }
        },
        {
          "if": {
            "properties": { "actor_type": { "const": "baseline" } },
            "required": ["actor_type"]
          },
          "then": { "required": ["baseline_id"] }
        }
      ]
    },
    "modelRoster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roster_id", "version", "description", "actor_ids"],
      "properties": {
        "roster_id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "actor_ids": {
          "type": "array",
          "minItems": 4,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "modelRosterRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "registry_version", "benchmark_id", "description", "actors", "rosters", "prompt_pipeline"],
      "properties": {
        "schema_version": { "type": "string", "const": "v1" },
        "registry_version": { "type": "string", "const": "long_horizon_model_roster_registry_v1" },
        "benchmark_id": { "type": "string", "const": "monopoly-long-v1" },
        "description": { "type": "string" },
        "actors": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/actor" }
        },
        "rosters": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/modelRoster" }
        },
        "prompt_pipeline": { "$ref": "#/$defs/promptPipelineMarker" }
      }
    },
    "campaignConfig": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "schema_version",
        "campaign_config_version",
        "campaign_id",
        "benchmark_id",
        "seed_cohort",
        "model_roster",
        "repetitions_per_seed",
        "seat_permutation",
        "max_turns",
        "dry_run",
        "prompt_pipeline"
      ],
      "properties": {
        "schema_version": { "type": "string", "const": "v1" },
        "campaign_config_version": { "type": "string", "const": "long_horizon_campaign_config_v1" },
        "campaign_id": { "type": "string", "minLength": 1 },
        "benchmark_id": { "type": "string", "const": "monopoly-long-v1" },
        "seed_cohort": { "type": "string", "minLength": 1 },
        "model_roster": { "type": "string", "minLength": 1 },
        "repetitions_per_seed": { "type": "integer", "minimum": 1 },
        "seat_permutation": {
          "type": "string",
          "enum": ["latin_square", "full", "seeded_random", "configured_order"]
        },
        "max_turns": { "type": "integer", "minimum": 1 },
        "max_trade_exchanges": { "type": "integer", "minimum": 1 },
        "max_auction_actions": { "type": "integer", "minimum": 1 },
        "cost_budget": { "type": "number", "minimum": 0 },
        "concurrency": { "type": "integer", "minimum": 1 },
        "budget_policy": { "type": "string" },
        "dry_run": { "type": "boolean" },
        "resume": { "type": "boolean" },
        "continue_on_failure": { "type": "boolean" },
        "replay_after_run": { "type": "boolean" },
        "build_scorecard_after_run": { "type": "boolean" },
        "build_trace_after_run": { "type": "boolean" },
        "build_failure_taxonomy_after_run": { "type": "boolean" },
        "prompt_pipeline": { "$ref": "#/$defs/promptPipelineMarker" }
      }
    }
  }
}
