{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "micro_suite.schema.json",
  "title": "MicroSuite",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite_id",
    "title",
    "description",
    "scenario_ids",
    "categories",
    "scoring_version",
    "prompt_conditions"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "v1" },
    "suite_id": { "type": "string" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "scenario_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "categories": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "BUY_OR_AUCTION",
        "AUCTION",
        "TRADE_PROPOSE",
        "TRADE_RESPONSE",
        "BUILD_OR_MORTGAGE",
        "LIQUIDATION",
        "JAIL",
        "POST_TURN_STRATEGY"
      ],
      "properties": {
        "BUY_OR_AUCTION": { "$ref": "#/$defs/category" },
        "AUCTION": { "$ref": "#/$defs/category" },
        "TRADE_PROPOSE": { "$ref": "#/$defs/category" },
        "TRADE_RESPONSE": { "$ref": "#/$defs/category" },
        "BUILD_OR_MORTGAGE": { "$ref": "#/$defs/category" },
        "LIQUIDATION": { "$ref": "#/$defs/category" },
        "JAIL": { "$ref": "#/$defs/category" },
        "POST_TURN_STRATEGY": { "$ref": "#/$defs/category" }
      }
    },
    "scoring_version": { "type": "string" },
    "prompt_conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "live_game"
        ]
      }
    }
  },
  "$defs": {
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_count"],
      "properties": {
        "target_count": { "type": "integer", "minimum": 1 },
        "actual_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
