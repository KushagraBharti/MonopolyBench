{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cloud.schema.json",
  "title": "Cloud runner v1 contracts",
  "$defs": {
    "campaignPrepareRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 80},
        "seed_blocks": {"type": "integer", "minimum": 1, "maximum": 20},
        "concurrency": {"type": "integer", "minimum": 1, "maximum": 5},
        "cost_budget": {"type": ["number", "null"], "exclusiveMinimum": 0}
      }
    },
    "singleGamePrepareRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "models": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "string"}},
        "effort": {"enum": ["low", "medium", "high"]},
        "max_turns": {"type": ["integer", "null"], "minimum": 1, "maximum": 10000},
        "cost_budget": {"type": ["number", "null"], "exclusiveMinimum": 0}
      }
    },
    "smokePrepareRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "models": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "string"}},
        "effort": {"enum": ["low", "medium", "high"]},
        "max_turns": {"type": "integer", "minimum": 5, "maximum": 10},
        "count": {"type": "integer", "minimum": 1, "maximum": 20},
        "cost_budget": {"type": ["number", "null"], "exclusiveMinimum": 0}
      }
    },
    "campaignCreateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preparation_id", "idempotency_key"],
      "properties": {
        "preparation_id": {"type": "string"},
        "idempotency_key": {"type": "string", "minLength": 8, "maxLength": 128}
      }
    },
    "campaignReadiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["can_start", "reasons"],
      "properties": {
        "can_start": {"type": "boolean"},
        "reasons": {"type": "array", "items": {"type": "string"}}
      }
    },
    "campaignPreparation": {
      "type": "object",
      "required": ["preparation_id", "config", "cells", "readiness", "git_sha", "image_digest"],
      "properties": {
        "preparation_id": {"type": "string"},
        "config": {"$ref": "research_registry.schema.json#/$defs/campaignConfigV2"},
        "readiness": {"$ref": "#/$defs/campaignReadiness"},
        "git_sha": {"type": "string"},
        "image_digest": {"type": "string"},
        "cells": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["cell_index", "run_id", "seed", "execution_rank", "models_by_seat"],
            "properties": {
              "cell_index": {"type": "integer", "minimum": 0},
              "run_id": {"type": "string"},
              "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
              "execution_rank": {"type": "integer", "minimum": 0},
              "models_by_seat": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "string"}}
            }
          }
        }
      }
    },
    "job": {
      "type": "object",
      "required": [
        "job_id",
        "run_id",
        "kind",
        "status"
      ],
      "properties": {
        "job_id": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "smoke",
            "single",
            "campaign"
          ]
        },
        "status": {
          "enum": [
            "queued",
            "running",
            "paused",
            "recovering",
            "finalizing",
            "completed",
            "failed",
            "cancelled"
          ]
        }
      }
    },
    "live": {
      "type": "object",
      "required": [
        "schema_version",
        "type",
        "job_id",
        "run_id"
      ],
      "properties": {
        "schema_version": {
          "const": "v2"
        },
        "type": {
          "enum": [
            "HELLO",
            "SNAPSHOT",
            "EVENT"
          ]
        },
        "job_id": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "commit_seq": {
          "type": "integer",
          "minimum": 0
        },
        "recovery_generation": {
          "type": "integer",
          "minimum": 0
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "snapshot": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "call": {
      "type": "object",
      "required": [
        "call_id",
        "decision_id",
        "resolver_stage",
        "payload",
        "payload_raw",
        "payload_sha256"
      ],
      "properties": {
        "call_id": {
          "type": "string"
        },
        "decision_id": {
          "type": "string"
        },
        "resolver_stage": {
          "enum": [
            0,
            1
          ]
        },
        "payload": {
          "type": "object"
        },
        "payload_raw": {
          "type": "string"
        },
        "payload_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "commit": {
      "type": "object",
      "required": [
        "job_id",
        "commit_seq",
        "journal_seq",
        "offsets_json",
        "recovery_generation"
      ],
      "properties": {
        "job_id": {
          "type": "string"
        },
        "commit_seq": {
          "type": "integer",
          "minimum": 1
        },
        "journal_seq": {
          "type": "integer",
          "minimum": 1
        },
        "offsets_json": {
          "type": "string"
        },
        "recovery_generation": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "journal": {
      "type": "object",
      "required": [
        "journal_seq",
        "kind",
        "targets",
        "recovery_generation"
      ],
      "properties": {
        "journal_seq": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "type": "string"
        },
        "recovery_generation": {
          "type": "integer",
          "minimum": 0
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "offset",
              "length",
              "sha256",
              "data",
              "append"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "offset": {
                "type": "integer",
                "minimum": 0
              },
              "length": {
                "type": "integer",
                "minimum": 0
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "data": {
                "type": "string"
              },
              "append": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "repair": {
      "type": "object",
      "required": [
        "commit_seq",
        "files"
      ],
      "properties": {
        "commit_seq": {
          "type": "integer",
          "minimum": 1
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "start",
              "end",
              "sha256"
            ]
          }
        }
      }
    },
    "executionManifest": {
      "type": "object",
      "required": [
        "git_sha",
        "image_digest",
        "execution_policy_version",
        "python",
        "endpoints",
        "prompt_sha256",
        "kind"
      ],
      "properties": {
        "git_sha": {
          "type": "string"
        },
        "image_digest": {
          "type": "string"
        },
        "execution_policy_version": {
          "enum": ["execution_policy_v1", "execution_policy_v2", "execution_policy_v3"]
        },
        "python": {
          "type": "string"
        },
        "endpoints": {
          "type": "object"
        },
        "response_policy": {
          "type": "object",
          "required": ["version", "fallback_models", "stages", "trigger", "max_resolver_calls"],
          "properties": {
            "version": {"const": "claude_refusal_recovery_v1"},
            "fallback_models": {"type": "object", "additionalProperties": {"type": "string"}},
            "stages": {"type": "array", "items": {"type": "string"}},
            "trigger": {"const": "explicit_provider_refusal"},
            "max_resolver_calls": {"const": 3}
          }
        },
        "prompt_sha256": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "smoke",
            "single",
            "campaign"
          ]
        }
      }
    },
    "storageManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "manifest_version",
        "files",
        "tree_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "v1"
        },
        "manifest_version": {
          "const": "storage_manifest_v1"
        },
        "tree_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "bytes",
              "sha256",
              "role"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "role": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
