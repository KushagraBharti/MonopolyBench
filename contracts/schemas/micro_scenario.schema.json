{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "micro_scenario.schema.json",
  "title": "MicroScenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_id",
    "suite_id",
    "category",
    "difficulty",
    "title",
    "description",
    "tags",
    "focal_player_id",
    "decision_point",
    "evaluation",
    "reference_policy"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "v1"
    },
    "scenario_id": {
      "type": "string"
    },
    "suite_id": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "BUY_OR_AUCTION",
        "AUCTION",
        "TRADE_PROPOSE",
        "TRADE_RESPONSE",
        "BUILD_OR_MORTGAGE",
        "LIQUIDATION",
        "JAIL",
        "POST_TURN_STRATEGY"
      ]
    },
    "difficulty": {
      "type": "string",
      "enum": ["easy", "medium", "hard"]
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "focal_player_id": {
      "type": "string"
    },
    "decision_point": {
      "$ref": "decision.schema.json"
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "scoring_mode", "rubric"],
      "properties": {
        "schema_version": { "type": "string", "const": "v1" },
        "scoring_mode": { "type": "string", "const": "rubric_v1" },
        "preferred_actions": {
          "type": "array",
          "items": { "$ref": "action.schema.json" }
        },
        "acceptable_actions": {
          "type": "array",
          "items": { "$ref": "action.schema.json" }
        },
        "bad_actions": {
          "type": "array",
          "items": { "$ref": "action.schema.json" }
        },
        "rubric": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["criterion_id", "description", "type", "max_points", "params"],
            "properties": {
              "criterion_id": { "type": "string" },
              "description": { "type": "string" },
              "type": {
                "type": "string",
                "enum": [
                  "action_name_is",
                  "action_name_in",
                  "arg_equals",
                  "arg_in_range",
                  "bid_at_least",
                  "bid_at_most",
                  "bid_between",
                  "trade_target_is",
                  "trade_offer_contains_property",
                  "trade_request_contains_property",
                  "trade_offer_cash_between",
                  "trade_request_cash_between",
                  "trade_completes_focal_monopoly",
                  "builds_on_group",
                  "build_count_between",
                  "mortgages_space",
                  "uses_jail_card",
                  "keeps_cash_above",
                  "private_thought_mentions",
                  "public_message_nonempty"
                ]
              },
              "max_points": { "type": "number", "exclusiveMinimum": 0 },
              "params": { "type": "object", "additionalProperties": true }
            }
          }
        }
      }
    },
    "reference_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "action", "rationale"],
      "properties": {
        "name": { "type": "string" },
        "action": { "$ref": "action.schema.json" },
        "rationale": { "type": "string" }
      }
    },
    "research_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "visibility",
        "review_status",
        "review_priority",
        "target_capability",
        "target_behavior",
        "strategic_tension",
        "expected_failure_modes",
        "taxonomy_tags",
        "counterfactual_pair_id",
        "counterfactual_role",
        "paper_section",
        "notes_for_researchers",
        "source_claims",
        "source_urls",
        "created_by",
        "last_reviewed_at",
        "prompt_immutability_checked"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "micro_research_metadata_v1"
        },
        "visibility": {
          "type": "string",
          "const": "research_only_never_prompt"
        },
        "review_status": {
          "type": "string",
          "enum": ["draft", "reviewed_first_pass", "reviewed_final"]
        },
        "review_priority": {
          "type": "string",
          "enum": ["normal", "medium", "high"]
        },
        "target_capability": {
          "type": "string"
        },
        "target_behavior": {
          "type": "string"
        },
        "strategic_tension": {
          "type": "string"
        },
        "expected_failure_modes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "taxonomy_tags": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "counterfactual_pair_id": {
          "type": ["string", "null"]
        },
        "counterfactual_role": {
          "type": ["string", "null"],
          "enum": ["baseline", "contrast", null]
        },
        "paper_section": {
          "type": "string"
        },
        "notes_for_researchers": {
          "type": "string"
        },
        "source_claims": {
          "type": "array",
          "items": { "type": "string" }
        },
        "source_urls": {
          "type": "array",
          "items": { "type": "string" }
        },
        "created_by": {
          "type": "string"
        },
        "last_reviewed_at": {
          "type": "string",
          "format": "date"
        },
        "prompt_immutability_checked": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "research_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "url", "claim", "used_for"],
        "properties": {
          "title": { "type": "string" },
          "url": { "type": "string" },
          "claim": { "type": "string" },
          "used_for": { "type": "string" }
        }
      }
    },
    "notes": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
