{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "failure_finding.schema.json",
  "title": "FailureFinding",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "failure_taxonomy_version",
    "kind",
    "run_id",
    "finding_id",
    "finding_type",
    "severity",
    "confidence",
    "status",
    "human_review_required",
    "human_review_status"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "v1" },
    "trace_analyzer_version": { "type": "string" },
    "failure_taxonomy_version": { "type": "string" },
    "kind": { "type": "string", "enum": ["failure", "trace"] },
    "run_id": { "type": "string" },
    "finding_id": { "type": "string" },
    "finding_type": { "type": "string" },
    "severity": { "type": "string", "enum": ["low", "medium", "high"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "status": { "type": "string", "enum": ["deterministic", "candidate"] },
    "turn_index": { "type": ["integer", "null"], "minimum": 0 },
    "decision_id": { "type": ["string", "null"] },
    "player_id": { "type": ["string", "null"] },
    "model_id": { "type": ["string", "null"] },
    "event_seq_start": { "type": ["integer", "null"], "minimum": 0 },
    "event_seq_end": { "type": ["integer", "null"], "minimum": 0 },
    "supporting_event_ids": { "type": "array", "items": { "type": ["string", "null"] } },
    "supporting_action_ids": { "type": "array", "items": { "type": ["string", "null"] } },
    "supporting_decision_ids": { "type": "array", "items": { "type": ["string", "null"] } },
    "summary": { "type": "string" },
    "details": { "type": "object", "additionalProperties": true },
    "derived_metrics": { "type": "object", "additionalProperties": true },
    "snapshot_path": { "type": ["string", "null"] },
    "human_review_required": { "type": "boolean" },
    "human_review_status": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } }
  }
}
