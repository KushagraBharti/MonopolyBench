176 {"cash": 160, "action": {"action": "accept_trade", "args": {}, "decision_id": "campaign-c0761df29478459ab4cea725626ea259-6-f3049e5157-dec-000176", "private_thought": "Accept $120 → $280. From Virginia the re-roll only forces a BW house sale on Illinois ($300, 3/36). At $160, reds 7/9/10 plus orange 1-house 4/5 are 20/36 forced sales and kill the $1400 rent. $20 more doesn't save BW3 on Illinois; p4 called $120 final, so don't risk a walk-away. Keep Vermont. Do not build before the re-roll. Pinks still need p1's States; utilities won't hit this roll.", "public_message": "Deal. $120 and the three are yours — mortgages included.", "schema_version": "v1"}, "events": [{"seq": 1148, "type": "TRADE_ACCEPTED", "payload": {"counterparty_player_id": "p4", "exchange_index": 3, "initiator_player_id": "p2", "max_exchanges": 20, "offer": {"cash": 120, "get_out_of_jail_cards": 0, "properties": []}, "request": {"cash": 0, "get_out_of_jail_cards": 0, "properties": ["ST_CHARLES_PLACE", "WATER_WORKS", "PENNSYLVANIA_RAILROAD"]}}}, {"seq": 1149, "type": "CASH_CHANGED", "payload": {"delta": -120, "player_id": "p4", "reason": "TRADE_CASH"}}, {"seq": 1150, "type": "CASH_CHANGED", "payload": {"delta": 120, "player_id": "p2", "reason": "TRADE_CASH"}}, {"seq": 1151, "type": "PROPERTY_TRANSFERRED", "payload": {"from_player_id": "p2", "mortgaged": true, "space_index": 11, "to_player_id": "p4"}}, {"seq": 1152, "type": "PROPERTY_TRANSFERRED", "payload": {"from_player_id": "p2", "mortgaged": true, "space_index": 28, "to_player_id": "p4"}}, {"seq": 1153, "type": "PROPERTY_TRANSFERRED", "payload": {"from_player_id": "p2", "mortgaged": true, "space_index": 15, "to_player_id": "p4"}}, {"seq": 1154, "type": "CASH_CHANGED", "payload": {"delta": -25, "player_id": "p4", "reason": "MORTGAGE_INTEREST"}}]}
