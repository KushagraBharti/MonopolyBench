225 {"cash": 349, "action": {"action": "declare_bankruptcy", "args": {}, "decision_id": "campaign-c0761df29478459ab4cea725626ea259-6-f3049e5157-dec-000225", "private_thought": "I owe $1,100 on Park Place and have $349 cash (shortfall $751). Selling all 5 Red houses ($375) and mortgaging all three Red properties ($340) would only raise $715, leaving me $36 short of $1,100. Since it is mathematically impossible to cover the rent, I must declare bankruptcy.", "public_message": "Even liquidating all my houses and mortgaging the Reds leaves me $36 short of $1,100. Good game, everyone!", "schema_version": "v1"}, "events": [{"seq": 1496, "type": "CASH_CHANGED", "payload": {"delta": -349, "player_id": "p1", "reason": "BANKRUPTCY_CASH"}}, {"seq": 1497, "type": "CASH_CHANGED", "payload": {"delta": 349, "player_id": "p2", "reason": "BANKRUPTCY_CASH"}}, {"seq": 1498, "type": "CASH_CHANGED", "payload": {"delta": 0, "player_id": "p1", "reason": "BANKRUPTCY"}}, {"seq": 1509, "type": "DICE_ROLLED", "payload": {"d1": 2, "d2": 5, "is_double": false}}, {"seq": 1510, "type": "PLAYER_MOVED", "payload": {"from": 17, "passed_go": false, "to": 24}}]}
