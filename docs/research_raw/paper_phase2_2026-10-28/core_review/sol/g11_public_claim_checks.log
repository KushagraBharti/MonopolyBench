215 {"cash": 463, "action": {"action": "propose_trade", "args": {"offer": {"cash": 200, "get_out_of_jail_cards": 0, "properties": ["MARVIN_GARDENS", "NORTH_CAROLINA_AVENUE"]}, "request": {"cash": 0, "get_out_of_jail_cards": 0, "properties": ["ST_JAMES_PLACE", "TENNESSEE_AVENUE", "NEW_YORK_AVENUE"]}, "to_player_id": "p3"}, "decision_id": "campaign-c0761df29478459ab4cea725626ea259-6-f3049e5157-dec-000215", "private_thought": "Need a stronger monopoly to challenge dark blues. Offer p3 $500 immediate liquidity versus $280 mortgaged oranges. If accepted, redeem and develop oranges by mortgaging spare pinks, utilities and railroads; keep eight brown houses.", "public_message": "$200 plus Marvin Gardens and North Carolina for your mortgaged oranges. Cash now, plus $300 in available mortgages without redemption costs.", "schema_version": "v1"}, "events": []}
