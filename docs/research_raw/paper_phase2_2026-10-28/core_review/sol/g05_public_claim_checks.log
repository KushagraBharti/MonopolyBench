223 {"you_cash": 204, "holdings": 7, "others_cash": {"p1": 848, "p2": 62, "p4": 306}, "action": {"action": "drop_out", "args": {}, "decision_id": "campaign-c0761df29478459ab4cea725626ea259-0-f5a29652ac-dec-000223", "private_thought": "I only have $204 cash and the minimum next bid is $206, so I must drop out. At least I forced p1 to pay $205 instead of $100 for Oriental Avenue.", "public_message": "All yours at $205.", "schema_version": "v1"}, "economic_events": [{"seq": 1643, "type": "PROPERTY_PURCHASED", "payload": {"player_id": "p1", "price": 205, "space_index": 6}}, {"seq": 1644, "type": "CASH_CHANGED", "payload": {"delta": -205, "player_id": "p1", "reason": "auction_bid"}}]}
