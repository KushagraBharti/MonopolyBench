          "properties": []
        }
      },
      "decision_id": "campaign-c0761df29478459ab4cea725626ea259-7-eb71418166-dec-000149",
      "public_message": "$240 and it's done. You'd still have about $450 for houses on a full monopoly. That's my last number.",
      "schema_version": "v1"
    },
    "150": {
      "action": "counter_trade",
      "args": {
        "offer": {
          "cash": 210,
